# ============================================================
# Graph Database Cloud Benchmarking — environment variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit your `.env` — it is git-ignored.
# ============================================================

# ---- Dataset generation ----
DATASET_NODES=30000
DATASET_EDGES=100000
DATASET_SEED=42

# ---- CognoDB Cloud (bolt+s) ----
# From console.cognodb.com — instance URI + password shown once at provisioning
COGNODB_URI=bolt+s://db-ab29aa4d.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=replace-me

# ---- Neo4j AuraDB Free (bolt+s) ----
NEO4J_URI=bolt+s://<your-aura-instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me

# ---- Memgraph (self-hosted, Docker) ----
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ---- ArangoDB (self-hosted, Docker) ----
ARANGO_URI=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=replace-me

# ---- JanusGraph (self-hosted, Docker via Gremlin) ----
JANUSGRAPH_URI=ws://localhost:8182/gremlin

# ---- Benchmark behaviour ----
ITERATIONS=100            # read iterations after warm-up (>=100 suggested)
WARMUP_ITERATIONS=10      # warm-up runs before measuring
MIXED_CONCURRENCY=1,10,40 # comma-separated concurrency sweep
MIXED_READ_WRITE_RATIO=0.8 # 80% reads / 20% writes
RESULTS_DIR=./results
